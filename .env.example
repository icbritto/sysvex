# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores antes
# de subir o docker compose. NÃO faça commit do arquivo ".env" preenchido.

# Porta HTTP em que o SYSVEX ficará disponível na LXC (ex.: http://IP-DA-LXC:8080)
HTTP_PORT=8080

# Origem permitida para CORS (deixe igual à URL que você vai acessar no navegador)
CORS_ORIGIN=http://localhost:8080

# Banco de dados (Postgres)
DB_USERNAME=sysvex
DB_PASSWORD=troque-esta-senha
DB_NAME=sysvex
# Depois do primeiro deploy bem-sucedido, considere mudar para "false" e
# gerenciar o schema via migrations do TypeORM.
DB_SYNCHRONIZE=true

# Identifica qual ambiente da paisagem DEV/QAS/PRD esta instância é — usado
# só para exibir um aviso visível no topo da tela em DEV/QAS (evita
# confundir com produção). Deixe em branco (ou "prd") numa instância única.
# Veja deploy/LANDSCAPE_DEV_QAS_PRD.md. Valores aceitos: dev, qas, prd.
SYSVEX_ENV=prd

# Segredo usado para assinar os tokens JWT — gere um valor aleatório longo,
# por exemplo com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-para-uma-string-aleatoria-longa
JWT_EXPIRES_IN=8h

# Usuário administrador criado automaticamente no primeiro "npm run seed"
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@suaempresa.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-tambem
# Cria alguns produtos/fornecedores de exemplo (fábrica de doces) para
# facilitar os primeiros testes. Mude para "false" para pular.
SEED_SAMPLE_DATA=true
